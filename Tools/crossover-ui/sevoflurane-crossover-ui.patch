+void sevo_ui_record(NSString *kind, NSWindow *window)
+{
+    NSString *home = NSHomeDirectory();
+    NSString *path = [home stringByAppendingPathComponent:@"Library/Logs/Sevoflurane-windows.log"];
+    FILE *record = fopen([path fileSystemRepresentation], "a");
+    if (record)
+    {
+        NSString *title = window ? [window title] : @"";
+        NSSize size = window ? [window frame].size : NSZeroSize;
+        fprintf(record, "%s suppressed pid=%d exe=%s kind=%s title=%s size=%.0fx%.0f\n",
+                [[[NSDate date] description] UTF8String], getpid(), sevo_ui_executable(),
+                [kind UTF8String], [title UTF8String], size.width, size.height);
+        fclose(record);
+    }
+}
